@model project2.ViewModels.DocumentInputViewModel
@{
    ViewData["Title"] = "New document";
}

<div class="editor-shell">
    <div class="editor-heading">
        <div>
            <span class="eyebrow">NEW DOCUMENT</span>
            <h1>Capture your next idea</h1>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control form-control-lg mb-3" />
        <span asp-validation-for="Title" class="text-danger"></span>
        <label asp-for="Content" class="form-label mt-3"></label>
        <textarea id="tiny" asp-for="Content"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
        <div class="editor-footer">
            <a class="btn btn-link" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Save document</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
