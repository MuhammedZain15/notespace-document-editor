<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="NoteSpace is a secure personal rich-text document workspace." />
    <title>@ViewData["Title"] · NoteSpace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (document.querySelector('textarea#tiny')) {
                tinymce.init({
                    selector: 'textarea#tiny',
                    height: 520,
                    menubar: false,
                    plugins: 'advlist autolink lists link charmap preview searchreplace visualblocks fullscreen insertdatetime table help wordcount',
                    toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright | bullist numlist | link table | removeformat | fullscreen',
                    content_style: 'body { font-family: DM Sans, sans-serif; font-size: 16px; line-height: 1.7; }'
                });
            }
        });
    </script>
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Docs" asp-action="Index"><span>✦</span> NoteSpace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Docs" asp-action="Index">Documents</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Docs" asp-action="Create">New document</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main class="container app-main" role="main">@RenderBody()</main>
    <footer class="app-footer"><div class="container">Built with ASP.NET Core MVC · NoteSpace © 2026</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
